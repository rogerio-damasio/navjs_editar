<%- include("../partials/header") %>
    <%- include("../partials/nav") %>
        <div class="container mt-5">
            <div class="row justify-content-center">
                <div class="col-md-8 col-lg-6">
                    <div class="card shadow-sm">
                        <div class="card-header bg-primary text-white">
                            <h4 class="mb-0">Novo cliente</h4>
                        </div>

                        <div class="card-body">
                            <form action="" method="POST">
                                <div class="mb-3">
                                    <label for="nome" class="form-label"> Nome </label>

                                    <input type="text" class="form-control" id="nome" name="nome"
                                        placeholder="Digite o nome" required value="<%= categoria.nome%>"/>
                                </div>

                                <div class="mb-3">
                                    <label for="email" class="form-label"> Email </label>

                                    <input type="email" class="form-control" id="email" name="email" rows="4"
                                        placeholder="Digite o email" value="<%= categoria.nome%>">
                                    </input>
                                </div>

                                <div class="mb-3">
                                    <label for="telefone" class="form-label"> Telefone </label>

                                    <input type="tel" class="form-control" id="telefone" name="telefone" rows="4"
                                        placeholder="Digite o telefone" value="<%= categoria.nome%>">
                                    </input>
                                </div>

                                <div class="mb-3">
                                    <label for="cidade" class="form-label"> Cidade </label>

                                    <input type="text" class="form-control" id="cidade" name="cidade" rows="4"
                                        placeholder="Digite sua cidade" value="<%= categoria.nome%>">
                                    </input>
                                </div>

                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-success">Editar</button>

                                    <a href="/clientes" class="btn btn-secondary"> Cancelar </a>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <%- include("../partials/footer") %>